{
  "name": "diamondvault",
  "version": "1.0.0",
  "private": true,
  "description": "Free Fire Diamond Top-Up storefront",
  "type": "module",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/app.css --minify",
    "dev": "tailwindcss -i ./src/input.css -o ./assets/css/app.css --watch",
    "test": "node --test",
    "serve": "node server.ts",
    "start": "npm run build && node server.ts"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2"
  }
}
